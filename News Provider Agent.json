    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data || [];\n\nconst articles = data.map((item, index) => {\n  const category = item.categories && item.categories.length > 0\n    ? item.categories[item.categories.length - 1]\n    : 'General';\n\n  return `${index + 1}. **Title**: ${item.title}\n**Description**: ${item.description || 'No description available.'}\n**Category**: ${category}\n`;\n});\n\nreturn [\n  {\n    json: {\n      prompt: `Summarize the following news articles grouped by category with proper headings and readable paragraph summaries. Avoid copying content verbatim. Use natural language and write for a general reader.\n\nHere are the articles:\n\n${articles.join('\\n\\n')}\n`\n    }\n  }\n];\n"
      },
